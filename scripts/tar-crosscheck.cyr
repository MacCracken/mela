# GNU tar cross-check helper (ADR-0008), driven by scripts/tar-crosscheck.sh.
# Exposes mela's real packer and reader to the shell:
#   pack <build_dir> <out_dir>    pack_flutter_app; prints the bundle path
#   list <bundle>                 prints the safe entry names, one per line
#   get  <bundle> <name> <out>    writes entry <name> to the file <out>
#   extract <bundle> <dir>        agpkg_extract_to_dir; prints the file count
# Exit 0 on success, 1 on a pack/read failure, 2 on bad usage.

include "src/category.cyr"
include "src/manifest.cyr"
include "src/depgraph.cyr"
include "src/trust.cyr"
include "src/transparency.cyr"
include "src/local_registry.cyr"
include "src/remote_client.cyr"
include "src/sandbox_profiles.cyr"
include "src/ratings.cyr"
include "src/flutter_packaging.cyr"
include "src/flutter_agpkg.cyr"
include "src/pipeline.cyr"

fn _xc_put(s: Str) {
    print(str_data(s), str_len(s));
    println("");
    return 0;
}

fn _xc_pack(build_dir, out_dir) {
    var wl = vec_new(); vec_push(wl, WL_CORE); vec_push(wl, WL_XDG_SHELL);
    var cfg = pfconfig_new(str_from("xcheck-app"), str_from("1.0.0"), str_from("Cross Check"),
      str_from("GNU tar cross-check fixture"), CAT_DESKTOP_APP, wl, 0, 0, str_from(""));
    var out = pack_flutter_app(str_from(build_dir), cfg, str_from(out_dir));
    if (out == 0) { return 1; }
    _xc_put(out);
    return 0;
}

fn _xc_list(bundle) {
    var names = agpkg_inspect(str_from(bundle));
    if (names == 0) { return 1; }
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        _xc_put(vec_get(names, i));
        i = i + 1;
    }
    return 0;
}

fn _xc_get(bundle, name, out) {
    var buf = alloc(AGPKG_BUF_MAXLEN);
    var n = file_read_all(bundle, buf, AGPKG_BUF_MAXLEN);
    if (n <= 0) { return 1; }
    var body = agpkg_read_entry(buf, n, str_from(name));
    if (body == 0) { return 1; }
    if (file_write_all(out, str_data(body), str_len(body)) < 0) { return 1; }
    return 0;
}

fn _xc_extract(bundle, dir) {
    var fb = _read_file(str_from(bundle));
    if (fb == 0) { return 1; }
    var n = agpkg_extract_to_dir(str_data(fb), str_len(fb), str_from(dir));
    if (n < 0) { return 1; }
    _xc_put(str_from_int(n));
    return 0;
}

fn main() {
    alloc_init();
    args_init();
    var n = argc();
    if (n < 3) {
        println("usage: tar-crosscheck pack <build_dir> <out_dir> | list <bundle> | get <bundle> <name> <out> | extract <bundle> <dir>");
        return 2;
    }
    var cmd = argv(1);
    if (streq(cmd, "pack") == 1) { if (n == 4) { return _xc_pack(argv(2), argv(3)); } }
    if (streq(cmd, "list") == 1) { if (n == 3) { return _xc_list(argv(2)); } }
    if (streq(cmd, "get") == 1)  { if (n == 5) { return _xc_get(argv(2), argv(3), argv(4)); } }
    if (streq(cmd, "extract") == 1) { if (n == 4) { return _xc_extract(argv(2), argv(3)); } }
    println("tar-crosscheck: bad command or argument count");
    return 2;
}

var r = main();
syscall(60, r);
